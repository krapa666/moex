# Общие параметры запуска приложения можно не задавать: ниже указаны значения по умолчанию.
MOEX_BACKEND_BIND=127.0.0.1
MOEX_BACKEND_PORT=18000
MOEX_FRONTEND_BIND=127.0.0.1
MOEX_FRONTEND_PORT=8080

# Обязательно укажите пароль существующей или новой PostgreSQL перед запуском.
POSTGRES_DB=fair_price
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Монитор объёмов IMOEX: сбор по рабочим дням, время московское.
VOLUME_SCHEDULE_HOUR=18
VOLUME_SCHEDULE_MINUTE=40
VOLUME_SCHEDULE_TIMEZONE=Europe/Moscow
VOLUME_RUN_ON_STARTUP=true
VOLUME_BASELINE_SESSIONS=60
VOLUME_DISPLAY_SESSIONS=60
VOLUME_MIN_BASELINE_SESSIONS=60
VOLUME_SIGNAL_MIN_RATIO=3.6
VOLUME_SIGNAL_MAX_RATIO=6.5
VOLUME_MOEX_TIMEOUT_SECONDS=20
VOLUME_MOEX_CONCURRENCY=8
VOLUME_MOEX_HISTORY_ROWS=140

# Email-уведомления. Адрес получателя задаётся в веб-интерфейсе.
# Для Brevo: host=smtp-relay.brevo.com, port=587, username=логин SMTP,
# password=SMTP key. VOLUME_SMTP_FROM должен быть подтверждён у провайдера.
VOLUME_SMTP_ENABLED=false
VOLUME_SMTP_HOST=
VOLUME_SMTP_PORT=587
VOLUME_SMTP_USERNAME=
VOLUME_SMTP_PASSWORD=
VOLUME_SMTP_FROM=
VOLUME_SMTP_STARTTLS=true
VOLUME_SMTP_SSL=false

# Внешний адрес приложения без завершающего слеша, используется в письмах.
VOLUME_PUBLIC_BASE_URL=
