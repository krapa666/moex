# Общие параметры запуска приложения можно не задавать: ниже указаны значения по умолчанию.
MOEX_BACKEND_BIND=127.0.0.1
MOEX_BACKEND_PORT=18000
MOEX_FRONTEND_BIND=127.0.0.1
MOEX_FRONTEND_PORT=8080

# Обязательно укажите пароль существующей или новой PostgreSQL перед запуском.
POSTGRES_DB=fair_price
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Монитор объёмов акций TQBR: три сбора по рабочим дням, время московское.
VOLUME_SCHEDULE_HOUR=18
VOLUME_SCHEDULE_MINUTES=20,35,45
VOLUME_SCHEDULE_TIMEZONE=Europe/Moscow
VOLUME_RUN_ON_STARTUP=true
VOLUME_BASELINE_SESSIONS=60
VOLUME_DISPLAY_SESSIONS=60
VOLUME_MIN_BASELINE_SESSIONS=60
VOLUME_SIGNAL_MIN_RATIO=3.6
VOLUME_SIGNAL_MAX_RATIO=6.5
VOLUME_MOEX_TIMEOUT_SECONDS=20
VOLUME_MOEX_CONCURRENCY=8
VOLUME_MOEX_HISTORY_ROWS=140

# Автоматическая синхронизация прогнозов УК Арсагера.
# Обновляются только уже существующие тикеры в таблице аналитика с указанным именем.
ARSAGERA_ANALYST_NAME=Арсагера
ARSAGERA_SYNC_INTERVAL_HOURS=6
ARSAGERA_SYNC_CONCURRENCY=4
ARSAGERA_RUN_ON_STARTUP=true

# Встроенный независимый источник УК ДОХОДЪ.
# Источник заполняет только дивидендные прогнозы: rolling 12m profit намеренно не
# переносится в календарный прогноз чистой прибыли приложения.
DOHOD_ENABLED=true
DOHOD_ANALYST_NAME=ДОХОДЪ
DOHOD_SYNC_INTERVAL_HOURS=6
DOHOD_SYNC_CONCURRENCY=4
DOHOD_RUN_ON_STARTUP=true
# Необязательные исключения, если URL-slug источника отличается от тикера MOEX.
DOHOD_TICKER_ALIASES_JSON={}

# Независимая автоматическая модель fin-vista с календарными прогнозами ЧП и дивидендов.
# По умолчанию выключена: источник сам указывает, что прогнозы рассчитываются
# автоматически и не проходят ручную проверку, поэтому включайте его осознанно.
FINVISTA_ENABLED=false
FINVISTA_ANALYST_NAME=fin-vista (модель)
FINVISTA_SYNC_INTERVAL_HOURS=6
FINVISTA_SYNC_CONCURRENCY=4
FINVISTA_RUN_ON_STARTUP=true
# Необязательные исключения ticker MOEX -> slug fin-vista, например TCSG -> T.
FINVISTA_TICKER_ALIASES_JSON={}

# Дополнительные источники: опубликованные Google Sheets с отдельными вкладками по тикерам.
# JSON-массив оставьте пустым, если дополнительные источники не подключены.
# Пример:
# FORECAST_SHEETS_SOURCES_JSON=[{"analyst_name":"Demo","published_id":"2PACX-...","catalog_gid":"123456","sheet_aliases":{"SNGSP":"SNGS"}}]
FORECAST_SHEETS_SOURCES_JSON=[]
FORECAST_SHEETS_SYNC_INTERVAL_HOURS=6
FORECAST_SHEETS_SYNC_CONCURRENCY=4
FORECAST_SHEETS_RUN_ON_STARTUP=true

# Автоматические фактические годовые результаты из MOEX Corporate Information Center.
# CCI — лицензируемый/платный сервис Московской биржи; приложение не предоставляет
# подписку и не содержит учётных данных. По умолчанию интеграция выключена.
# Используется только краткая МСФО в рублях и только ЧП, относимая к собственникам/акционерам.
MOEX_CCI_ACTUALS_ENABLED=false
MOEX_CCI_USERNAME=
MOEX_CCI_PASSWORD=
MOEX_CCI_ACTUALS_SYNC_INTERVAL_HOURS=24
MOEX_CCI_ACTUALS_RUN_ON_STARTUP=false
MOEX_CCI_ACTUALS_YEARS_BACK=5
MOEX_CCI_TIMEOUT_SECONDS=30
MOEX_CCI_CONCURRENCY=4

# Email-уведомления. Адрес получателя хранится только в локальном .env.
# Для Brevo: host=smtp-relay.brevo.com, port=587, username=логин SMTP,
# password=SMTP key. VOLUME_SMTP_FROM должен быть подтверждён у провайдера.
VOLUME_SMTP_ENABLED=false
VOLUME_SMTP_HOST=
VOLUME_SMTP_PORT=587
VOLUME_SMTP_USERNAME=
VOLUME_SMTP_PASSWORD=
VOLUME_SMTP_FROM=
VOLUME_SMTP_STARTTLS=true
VOLUME_SMTP_SSL=false
VOLUME_NOTIFICATION_EMAIL=

# Внешний адрес приложения без завершающего слеша, используется в письмах.
VOLUME_PUBLIC_BASE_URL=https://moex.junnylab.ru
